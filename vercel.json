{
  "buildCommand": "bash build_vercel.sh",
  "outputDirectory": "build/web",
  "installCommand": "echo 'skip'",
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.pulsmarket.tech" }], "destination": "https://pulsmarket.tech/$1", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "www.pulsmarket.tech" }], "destination": "https://pulsmarket.tech/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/market-sitemap.xml", "destination": "/api/market-sitemap" },
    { "source": "/m/:slug", "destination": "/api/market-share?slug=:slug" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/disclaimer", "destination": "/disclaimer.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/stats", "destination": "/stats.html" },
    { "source": "/agent", "destination": "/agent.html" },
    { "source": "/pulse", "destination": "/pulse.html" },
    { "source": "/versus", "destination": "/versus.html" },
    { "source": "/explorer", "destination": "/explorer.html" },
    { "source": "/build", "destination": "/build.html" },
    { "source": "/cli", "destination": "/cli.html" },
    { "source": "/mobile-download", "destination": "/mobile-download.html" },
    { "source": "/((?!api/|_vercel/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*).(wasm|png|webp|ttf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
